{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "prompt-grammar",
  "displayName": "Prompt Grammar",
  "version": "1.0.0",
  "description": "Proofreads each prompt you send, shows grammar fixes inline or in the CLI status line, tracks mistake history, and coaches with /grammar stats, review, and ask.",
