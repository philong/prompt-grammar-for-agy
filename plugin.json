    "/grammar help",
    "/grammar stats 30d",
    "/grammar review"
  ],
  "author": {
    "name": "Phi-Long",
    "url": "https://github.com/philong"
  },
  "homepage": "https://github.com/philong/prompt-grammar-for-agy",
  "repository": "https://github.com/philong/prompt-grammar-for-agy",
  "license": "MIT",
  "keywords": [
    "grammar",
    "proofreading",
    "writing",
    "language",
    "coaching"
  ]
}
